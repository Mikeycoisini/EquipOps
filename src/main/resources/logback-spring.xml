<?xml version="1.0" encoding="UTF-8"?>
<configuration>
 <conversionRule conversionWord="safeMessage" class="com.common.logging.SafeMessageConverter"/>
 <springProperty scope="context" name="LOG_DIR" source="ops.log.directory" defaultValue="logs"/>
 <!-- 不渲染异常正文和堆栈；第三方组件仍须保持生产日志级别，不开启 SQL/请求调试。 -->
 <property name="FORMAT" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] requestId=%X{requestId:-none} %logger{48} - %safeMessage%n%nopex"/>
 <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender"><encoder><pattern>${FORMAT}</pattern></encoder></appender>
 <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
  <file>${LOG_DIR}/equipops.log</file>
  <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
   <fileNamePattern>${LOG_DIR}/archive/equipops.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
   <maxFileSize>10MB</maxFileSize><maxHistory>14</maxHistory><totalSizeCap>1GB</totalSizeCap><cleanHistoryOnStart>true</cleanHistoryOnStart>
  </rollingPolicy>
  <encoder><pattern>${FORMAT}</pattern></encoder>
 </appender>
 <root level="INFO"><appender-ref ref="CONSOLE"/><appender-ref ref="FILE"/></root>
</configuration>
